# 3.14-dev includes pip and a shell, which the TEST_ENV copy step needs.
FROM chainguard-docker.nexus.boozallencsn.com/bah-enterprise/python:3.14-dev
ARG http_proxy
ARG https_proxy
ARG no_proxy
ARG TEST_ENV=false

ENV http_proxy=$http_proxy \
    https_proxy=$https_proxy \
    no_proxy=$no_proxy \
    HTTP_PROXY=$http_proxy \
    HTTPS_PROXY=$https_proxy \
    NO_PROXY=$no_proxy

# Image defaults to nonroot; pip install and the test-file copy need root.
USER root

WORKDIR /app/indexer/
COPY ./requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

COPY ./prepare-test-files-indexer.sh /prepare-test-files-indexer.sh
COPY ./cypress /cypress
COPY ./ /app/indexer

RUN if [ "${TEST_ENV}" = "true" ]; then \
        echo "Test profile detected. Preparing test json file..."; \
        chmod +x /prepare-test-files-indexer.sh && \
        cd / && \
        TEST_ENV=true /prepare-test-files-indexer.sh || echo "Warning: prepare-test-files-indexer.sh failed"; \
    else \
        echo "Test profile not active. Skipping test file preparation."; \
    fi

USER nonroot

# Default ENTRYPOINT is /usr/bin/python; clear it so compose can use
# command: ["python", "-u", "index_programs.py"].
ENTRYPOINT []
CMD ["python", "-u", "index_programs.py"]
