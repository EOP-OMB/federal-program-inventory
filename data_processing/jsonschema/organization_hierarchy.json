{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SAM CFDA search payload fields used for organization hierarchy",
  "type": "object",
  "properties": {
    "_embedded": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "organizationHierarchy": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "organizationId": {
                      "type": "string"
                    },
                    "level": {
                      "type": "number"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "organizationId",
                    "level",
                    "name"
                  ]
                }
              }
            },
            "required": [
              "organizationHierarchy"
            ]
          }
        }
      },
      "required": [
        "results"
      ]
    }
  },
  "required": [
    "_embedded"
  ]
}
