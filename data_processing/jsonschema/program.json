{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SAM program payload used by transform.py",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "properties": {
        "programNumber": {
          "type": "string"
        },
        "organizationId": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "objective": {
          "type": [
            "string",
            "null"
          ]
        },
        "alternativeNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "compliance": {
          "type": "object",
          "properties": {
            "CFR200Requirements": {
              "type": "object",
              "properties": {
                "questions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "isSelected": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "code",
                      "isSelected"
                    ]
                  }
                }
              },
              "required": [
                "questions"
              ]
            },
            "documents": {
              "type": "object",
              "properties": {
                "description": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "description"
              ]
            }
          },
          "required": [
            "CFR200Requirements",
            "documents"
          ]
        },
        "financial": {
          "type": "object",
          "properties": {
            "accomplishments": {
              "type": "object",
              "properties": {
                "list": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "fiscalYear": {
                        "type": "number"
                      },
                      "description": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "description"
                    ]
                  }
                }
              },
              "required": [
                "list"
              ]
            },
            "obligations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "assistanceType": {
                    "type": "string"
                  },
                  "values": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "year": {
                          "type": "number"
                        },
                        "actual": {
                          "type": "number"
                        },
                        "estimate": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "year"
                      ]
                    }
                  }
                },
                "required": [
                  "values"
                ]
              }
            }
          },
          "required": [
            "accomplishments",
            "obligations"
          ]
        },
        "authorizations": {
          "type": "object",
          "properties": {
            "list": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "authorizationTypes": {
                    "type": "object",
                    "properties": {
                      "act": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "statute": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "publicLaw": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "USC": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "executiveOrder": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "act",
                      "statute",
                      "publicLaw",
                      "USC",
                      "executiveOrder"
                    ]
                  },
                  "act": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "properties": {
                      "title": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "part": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "section": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "description": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  },
                  "statute": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "properties": {
                      "volume": {
                        "type": [
                          "number",
                          "string",
                          "null"
                        ]
                      },
                      "page": {
                        "type": [
                          "number",
                          "string",
                          "null"
                        ]
                      }
                    }
                  },
                  "publicLaw": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "properties": {
                      "congressCode": {
                        "type": [
                          "number",
                          "string",
                          "null"
                        ]
                      },
                      "number": {
                        "type": [
                          "number",
                          "string",
                          "null"
                        ]
                      }
                    }
                  },
                  "USC": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "properties": {
                      "title": {
                        "type": [
                          "number",
                          "string",
                          "null"
                        ]
                      },
                      "section": {
                        "type": [
                          "string",
                          "number",
                          "null"
                        ]
                      }
                    }
                  },
                  "executiveOrder": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "properties": {
                      "title": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "part": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "section": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "description": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "required": [
                  "authorizationTypes"
                ]
              }
            }
          },
          "required": [
            "list"
          ]
        },
        "eligibility": {
          "type": "object",
          "properties": {
            "beneficiary": {
              "type": "object",
              "properties": {
                "types": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number"
                    ]
                  }
                }
              },
              "required": [
                "types"
              ]
            },
            "applicant": {
              "type": "object",
              "properties": {
                "types": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "types"
              ]
            }
          },
          "required": [
            "beneficiary",
            "applicant"
          ]
        }
      },
      "required": [
        "programNumber",
        "organizationId",
        "title",
        "objective",
        "alternativeNames",
        "compliance",
        "financial",
        "authorizations",
        "eligibility"
      ]
    }
  },
  "required": [
    "id",
    "data"
  ]
}