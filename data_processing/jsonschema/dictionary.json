{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SAM dictionaries payload used by transform.py",
  "type": "object",
  "properties": {
    "_embedded": {
      "type": "object",
      "properties": {
        "jSONObjectList": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "elements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "element_id": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    },
                    "elements": {
                      "type": [
                        "array",
                        "null"
                      ],
                      "items": {
                        "type": "object",
                        "properties": {
                          "element_id": {
                            "type": "string"
                          },
                          "value": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "element_id",
                          "value"
                        ]
                      }
                    }
                  }
                }
              }
            },
            "required": [
              "id"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "id": {
                      "const": "assistance_type"
                    }
                  },
                  "required": [
                    "id"
                  ]
                },
                "then": {
                  "required": [
                    "elements"
                  ],
                  "properties": {
                    "elements": {
                      "items": {
                        "required": [
                          "element_id",
                          "value",
                          "elements"
                        ]
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "id": {
                      "enum": [
                        "applicant_types",
                        "beneficiary_types"
                      ]
                    }
                  },
                  "required": [
                    "id"
                  ]
                },
                "then": {
                  "required": [
                    "elements"
                  ],
                  "properties": {
                    "elements": {
                      "items": {
                        "required": [
                          "element_id",
                          "value"
                        ]
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "required": [
        "jSONObjectList"
      ]
    }
  },
  "required": [
    "_embedded"
  ]
}
