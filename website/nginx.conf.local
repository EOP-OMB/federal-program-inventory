# This file contains the configuration for the nginx server
# responsible for serving the Federal Program Inventory website.

pid /tmp/nginx.pid;
worker_processes  1;

events {
  worker_connections  1024;
}

http {
  include   mime.types;
  index     index.html index.htm;
  server_tokens off;
  server {
    listen  8080;
    listen  [::]:8080;
    gzip    on;
    add_header Cache-Control "public, max-age=600, must-revalidate" always;

    location / {
      root        /usr/share/nginx/html;
      try_files   $uri $uri.html /index.html;
    }

# Change this based on if for local development or pushing to ECS
    location /api/ {
      proxy_pass http://api:8000;

      # Additional headers for HTTPS
      # Use this option for local development
      proxy_set_header Host $host;
      # Use this option for BAH ECS environment
      #proxy_set_header Host fpi-api-dev.oeads.boozallencsn.com;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;

      # Optional timeouts if needed
      proxy_connect_timeout 60s;
      proxy_read_timeout 60s;
      proxy_send_timeout 60s;

      add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
    }

  }
}